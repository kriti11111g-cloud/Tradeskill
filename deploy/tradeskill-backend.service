[Unit]
Description=Trade Skill FastAPI Backend
After=network.target mongod.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/tradeskill/backend
EnvironmentFile=/opt/tradeskill/backend/.env
ExecStart=/opt/tradeskill/backend/venv/bin/uvicorn server:app --host 127.0.0.1 --port 8011 --workers 1
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
